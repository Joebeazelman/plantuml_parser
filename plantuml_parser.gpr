with "uml_model";

project PlantUML_Parser is
   for Source_Dirs use ("src");
   for Object_Dir use "obj";
   for Library_Name use "plantuml_parser";
   for Library_Dir use "lib";
   for Library_Kind use "static";

   package Compiler is
      for Default_Switches ("Ada") use ("-gnat2022", "-gnatX", "-gnatwa");
   end Compiler;
end PlantUML_Parser;
