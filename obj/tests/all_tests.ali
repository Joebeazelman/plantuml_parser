V "GNAT Lib v16"
A -gnatA
A -gnat2022
A -gnatX
A -gnata
A -gnatwa
A -gnatVa
A -mmacosx-version-min=28.0.0
A -mcpu=apple-m1
A -mlittle-endian
A -mabi=lp64
A -fPIC
P ZX

RN
