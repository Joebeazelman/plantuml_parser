V "GNAT Lib v16"
A -gnatA
A -gnat2022
A -gnatX
A -gnata
A -gnatwa
A -gnatVa
A -mmacosx-version-min=28.0.0
A -mcpu=apple-m1
A -mlittle-endian
A -mabi=lp64
A -fPIC
P SS ZX

RN
RV NO_DISPATCH
RV NO_DISPATCHING_CALLS
RV NO_EXCEPTION_HANDLERS
RV NO_EXCEPTIONS
RV NO_NESTED_FINALIZATION
